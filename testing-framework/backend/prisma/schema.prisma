generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model Requirement {
  id          String                  @id @default(cuid())
  title       String
  content     String                  @default("")
  createdAt   DateTime                @default(now())
  updatedAt   DateTime                @updatedAt
  testCases   TestCase[]
  attachments RequirementAttachment[]
}

model RequirementAttachment {
  id            String      @id @default(cuid())
  requirementId String
  requirement   Requirement @relation(fields: [requirementId], references: [id], onDelete: Cascade)
  filename      String
  filePath      String
  mimeType      String      @default("")
  size          Int         @default(0)
  extractedText String?
  createdAt     DateTime    @default(now())
}

model TestCase {
  id               String     @id @default(cuid())
  requirementId    String
  requirement      Requirement @relation(fields: [requirementId], references: [id], onDelete: Cascade)
  caseId           String
  featurePointL1   String     @default("") // 一级功能点（大模块）
  featurePoint    String     @default("") // 二级功能点（一级下的模块）
  title            String
  priority         String     @default("P1")
  preconditions    String     @default("")
  steps            String     @default("")
  expected         String     @default("")
  validationPoints String     @default("")
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt
}
